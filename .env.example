# ==============================================================================
# Vaultzet Store - Environment Configuration
# ==============================================================================

# Canonical Site URL (Used for sitemaps, canonicals, Open Graph, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.vaultzet.shop

# Google Tag Manager (GTM Container ID - Primary tag orchestrator)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (Measurement ID - Direct or GTM fallback)
NEXT_PUBLIC_GA4_ID=G-7RMXL2RZ4J

# Google Search Console Verification (HTML meta tag content value)
NEXT_PUBLIC_GSC_VERIFICATION=googlef90de30240e3b03b

# Bing Webmaster Tools Verification (msvalidate.01 content value)
NEXT_PUBLIC_BING_VERIFICATION=

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# IndexNow Key for Bing & Yandex instant indexing
NEXT_PUBLIC_INDEXNOW_KEY=c3e2f1a94b8d7e0c9f1a2b3c4d5e6f7a

# Telegram Instant Alerts & Command Center
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ImgBB API Configuration (Secure server-side image upload for products)
# Get your free API key at: https://api.imgbb.com/ (Account -> Add API key)
# Add this exact key to Vercel Project Settings > Environment Variables
IMGBB_API_KEY=

# PayU India Payment Gateway (UPI, Google Pay, PhonePe, Paytm, Cards, NetBanking)
# You can set these in Vercel Environment Variables OR configure them directly in the Admin Panel:
# Admin Portal (/asdf) -> Settings & Integrations -> PayU Payment Gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=PRODUCTION


