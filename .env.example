# ==============================================================================
# Vaultzet Store - Environment Configuration
# ==============================================================================

# Canonical Site URL (Used for sitemaps, canonicals, Open Graph, and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.vaultzet.shop

# Google Tag Manager (Optional)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (Optional)
NEXT_PUBLIC_GA4_ID=

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools Verification (Optional)
NEXT_PUBLIC_BING_VERIFICATION=

# Meta (Facebook) Pixel ID (Optional - or configure in Admin Panel)
NEXT_PUBLIC_META_PIXEL_ID=

# IndexNow Key (Optional)
NEXT_PUBLIC_INDEXNOW_KEY=

# Telegram Instant Alerts (Optional - or configure in Admin Panel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# ImgBB API Configuration (Secure server-side image upload for products)
# Get your free API key at: https://api.imgbb.com/ (Account -> Add API key)
# Add this exact key to Vercel Project Settings > Environment Variables
IMGBB_API_KEY=

# PayU India Payment Gateway (UPI, Google Pay, PhonePe, Paytm, Cards, NetBanking)
# You can set these in Vercel Environment Variables OR configure them directly in the Admin Panel:
# Admin Portal (/asdf) -> Settings & Integrations -> PayU Payment Gateway
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=PRODUCTION


